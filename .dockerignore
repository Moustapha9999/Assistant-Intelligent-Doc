# ══════════════════════════════════════════════════════
# .dockerignore — Fichiers exclus de l'image Docker
# ══════════════════════════════════════════════════════

# Environnement virtuel Python
.venv/
venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Variables d'environnement (sécurité)
.env
.streamlit/secrets.toml

# Archive du corpus (publiée en release GitHub)
deploy/

# Données (montées en volume par docker-compose)
data/
qdrant_storage/
.claude/
cache_huggingface/
models_cache/
src/models_cache/

# Git / CI / tests (non requis à l'exécution)
.git/
.gitignore
.github/
tests/
pytest.ini
requirements-dev.txt

# IDE / archives locales
.idea/
.vscode/
*.iml
_archives/
_preview*/

# Logs
logs/
*.log

# Résultats temporaires
resultats/

# Docker
docker/
Dockerfile
.dockerignore

# Documentation / soutenance (hors image runtime)
docs/
notebooks/
knowledge/
scripts/
Mémoire-Master.docx
Pres-soutenance.pptx
README.md

# OS
.DS_Store
Thumbs.db