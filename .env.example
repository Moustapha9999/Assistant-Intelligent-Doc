# ── Clés API ──────────────────────────────────────────
GITHUB_TOKEN=ghp_xxx
GROQ_API_KEY=gsk_xxx

# ── LLM ───────────────────────────────────────────────
# llama-3.3-70b-versatile retiré de Groq (août 2026) → gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b
# Vision (images, OCR des PDF numérisés) : doit accepter les images (gpt-oss n'est que texte).
# groq/compound et llama-4-scout ne sont plus accessibles ; repli automatique sur qwen/qwen3.8-27b.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Génération d'images : auto | pollinations | openai | off
# auto = OpenAI si OPENAI_API_KEY, sinon Pollinations (gratuit, sans clé)
IMAGE_GEN_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.95
LLM_PRESENCE_PENALTY=0
LLM_FREQUENCY_PENALTY=0.2
MAX_TOKENS=3000
MAX_HISTORIQUE=8
MAX_HISTORIQUE_LEGER=6

# ── Embeddings / Reranking ────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Qdrant ────────────────────────────────────────────
# QDRANT_URL est prioritaire sur QDRANT_HOST/QDRANT_PORT.
# Local : http://localhost:6333 · Docker Compose : http://qdrant:6333 (imposé par docker-compose.yml)
# Qdrant Cloud : https://<cluster>.<region>.cloud.qdrant.io:6333 + QDRANT_API_KEY
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Délai client en secondes (la 1re recherche après redémarrage de Qdrant est lente)
QDRANT_TIMEOUT=30
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=github_docs
# Cible de scripts/migrer_vers_qdrant_cloud.py (la source reste localhost:6333)
# QDRANT_CLOUD_URL=https://<cluster>.<region>.cloud.qdrant.io:6333
# QDRANT_CLOUD_API_KEY=

# ── Corpus distant (déploiement cloud) ────────────────
# Archive produite par scripts/preparer_corpus_deploiement.py, publiée en release GitHub.
# Téléchargée au 1er démarrage si data/processed/chunks/tous_chunks.json est absent.
# CORPUS_URL=https://github.com/<owner>/<repo>/releases/download/corpus-v1/corpus_assistdoc.zip
# CORPUS_SHA256=

# ── Corpus / citations ────────────────────────────────
# Date de collecte des métadonnées GitHub (étoiles affichées « GitHub, <date> »)
DATE_COLLECTE_GITHUB=2026-06-11

# ── Comptes & admin AssistDoc ─────────────────────────
# Admin seed (créé automatiquement au 1er lancement)
ADMIN_EMAIL=admin@assistdoc.local
ADMIN_PASSWORD=changez_moi
# Compat ancienne auth (utilisée comme mdp admin si ADMIN_PASSWORD vide)
STREAMLIT_PASSWORD=
ADMIN_USERS=admin
# SHOW_ADMIN_CORPUS=0
# MFA de l'admin initial (base32, ≥ 16 caractères) — survit aux redéploiements à disque éphémère.
# Générer : python -c "from securite.totp import generer_secret; print(generer_secret())"
# ADMIN_TOTP_SECRET=

# ── Politique de sécurité (modifiable dans Admin → Sécurité → Configuration) ──
# SECU_MAX_ECHECS=5                  # échecs de connexion avant blocage temporaire
# SECU_FENETRE_MIN=15                # fenêtre / durée du blocage (minutes)
# SESSION_JOURS_COMPTE=14
# SESSION_JOURS_INVITE=30
# QUOTA_INVITES_GLOBAL_HEURE=200     # plafond global des requêtes invitées (0 = désactivé)
# SECU_SEUIL_REQ_HEURE=60            # volume horaire signalé comme inhabituel par compte
# SECU_RETENTION_TENTATIVES_JOURS=30

# Quotas quotidiens (requêtes chat)
QUOTA_GUEST_REQ=12
QUOTA_EMAIL_REQ=80
QUOTA_GITHUB_REQ=200
QUOTA_GOOGLE_REQ=120
QUOTA_GUEST_MIN=30
QUOTA_EMAIL_MIN=180
QUOTA_GITHUB_MIN=480
QUOTA_GOOGLE_MIN=360

# GitHub OAuth (optionnel — bouton activé seulement si renseigné)
# Créer une OAuth App : https://github.com/settings/developers
# Callback : http://localhost:8501/
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8501/

# Google OAuth (optionnel — bouton « Continuer avec Google »)
# Console : https://console.cloud.google.com/apis/credentials
# Type : Application Web — URI de redirection autorisée :
#   http://localhost:8501/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501/



# Taille max upload (octets) — défaut 10 Mo
UPLOAD_MAX_BYTES=10485760
# Pièces jointes : nombre par message, images envoyées à la vision, budget de contexte (caractères)
FICHIERS_MAX_PAR_MESSAGE=8
FICHIERS_MAX_IMAGES_VISION=5
FICHIERS_MAX_CHARS_PROMPT=12000
# Pages PDF numérisées passées à l'OCR (modèle de vision) par fichier
PDF_OCR_MAX_PAGES=5

# ── Sécurité API FastAPI ──────────────────────────────
# Clés API : cle1:owner1,cle2:owner2 (vide = accès libre en local)
# API_KEYS=
# Secret pour POST /ingest/webhook (header X-Ingest-Secret)
# INGEST_WEBHOOK_SECRET=
# Clé des routes /admin/* (header X-Admin-Key), ≥ 24 caractères, distincte d'ADMIN_PASSWORD.
# Absente = routes /admin/* fermées (503).
# ADMIN_API_KEY=
# Requêtes /ask et /feedback par minute et par clé
# API_LIMITE_PAR_MINUTE=30

# ── Recherche web ─────────────────────────────────────
# Tavily (https://app.tavily.com, 1 000 requêtes/mois gratuites). Sans clé : DuckDuckGo,
# qui bloque souvent les requêtes automatiques (seules les pistes YouTube restent).
# TAVILY_API_KEY=tvly-xxx

# ── Options runtime ───────────────────────────────────
# DESACTIVER_WEB_SEARCH=true
# MODE_RAGAS_EVAL=false
# WEB_TIMEOUT=5
# DISABLE_SSL_VERIFY=1   # dépannage proxy uniquement — JAMAIS en prod
