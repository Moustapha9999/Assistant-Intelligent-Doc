# Modèle des secrets Streamlit Community Cloud
# (share.streamlit.io → app → Settings → Secrets : coller ce contenu complété).
# Les clés de premier niveau sont exposées comme variables d'environnement : l'application
# les lit avec os.getenv, exactement comme le fichier .env en local.
# Ne jamais committer la version remplie (.streamlit/secrets.toml est dans .gitignore).

# ── LLM ───────────────────────────────────────────────
GROQ_API_KEY = "gsk_..."
LLM_MODEL = "openai/gpt-oss-120b"
GROQ_VISION_MODEL = "groq/compound"
MAX_TOKENS = "3000"

# ── Qdrant Cloud ──────────────────────────────────────
QDRANT_URL = "https://<cluster>.<region>.cloud.qdrant.io:6333"
QDRANT_API_KEY = "..."
QDRANT_COLLECTION_NAME = "github_docs"
QDRANT_TIMEOUT = "30"

# ── Corpus (tous_chunks.json + cache BM25) ────────────
CORPUS_URL = "https://github.com/Moustapha9999/Assistant-Intelligent-Doc/releases/download/corpus-v1/corpus_assistdoc.zip"
CORPUS_SHA256 = "<empreinte affichée par scripts/preparer_corpus_deploiement.py>"
DATE_COLLECTE_GITHUB = "2026-06-11"

# ── Recherche web ─────────────────────────────────────
TAVILY_API_KEY = "tvly-..."

# ── Comptes & admin ───────────────────────────────────
ADMIN_EMAIL = "admin@exemple.com"
ADMIN_PASSWORD = "<mot de passe fort>"
ADMIN_USERS = "admin"

# Quotas quotidiens (gardez-les bas : Groq gratuit = 8 000 tokens/min, 1 000 requêtes/jour)
QUOTA_GUEST_REQ = "5"
QUOTA_EMAIL_REQ = "40"
QUOTA_GITHUB_REQ = "80"
QUOTA_GOOGLE_REQ = "60"

# ── OAuth (optionnel) — redirection = URL publique de l'application ──
# GITHUB_OAUTH_CLIENT_ID = ""
# GITHUB_OAUTH_CLIENT_SECRET = ""
# GITHUB_OAUTH_REDIRECT_URI = "https://<votre-app>.streamlit.app/"
# GOOGLE_OAUTH_CLIENT_ID = ""
# GOOGLE_OAUTH_CLIENT_SECRET = ""
# GOOGLE_OAUTH_REDIRECT_URI = "https://<votre-app>.streamlit.app/"
# "0" seulement si le retour OAuth échoue avec « État OAuth invalide » (cookies bloqués)
# OAUTH_STATE_LIER_SESSION = "1"

# ── Sessions (cookie assistdoc_sid) ───────────────────
# SESSION_JOURS_INVITE = "30"
# SESSION_JOURS_COMPTE = "14"

# ── Divers ────────────────────────────────────────────
IMAGE_GEN_PROVIDER = "auto"
# Hugging Face : téléchargement anonyme des modèles ; un jeton évite les limites de débit
# HF_TOKEN = "hf_..."
